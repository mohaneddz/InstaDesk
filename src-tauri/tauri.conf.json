{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InstaDesk",
  "version": "0.2.1",
  "identifier": "com.instadesk.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:48317",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": ["main-webview", "instagram-webview", "inbox-webview", "settings-webview"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "InstaDesk contributors",
    "copyright": "Copyright © 2026 InstaDesk contributors",
    "category": "SocialNetworking",
    "shortDescription": "Unofficial Instagram desktop wrapper focused on private messages",
    "longDescription": "A lightweight, unofficial Instagram desktop wrapper with conservative private-DM notifications and tray support.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico", "icons/icon.icns"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
