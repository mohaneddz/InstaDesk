{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings-webview",
  "description": "Permissions for the settings dialog WebView (local shell only — get/update settings, drag/close)",
  "windows": ["settings"],
  "permissions": [
    "core:default",
    "allow-get-settings",
    "allow-update-settings",
    "allow-settings-ui-ready",
    "allow-window-action",
    "autostart:default",
    "core:window:allow-start-dragging",
    "core:window:allow-hide"
  ]
}
